REDIS_HOST=redis
FAISS_PATH=/data/faiss
LLM_API=http://llm:9000
STT_API=http://whisper:9000
TTS_API=http://tts:9000

# AWAAZ voice pipeline
GROQ_API_KEY=
FASTTEXT_MODEL_PATH=/tmp/lid.176.bin
OLLAMA_URL=http://localhost:11434/api/generate
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2:3b
MIXED_LANG_THRESHOLD=0.20
PURE_LANG_THRESHOLD=0.80
ENGLISH_HEAVY_THRESHOLD=0.35

# SMS / QR integration (single backend)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required only when include_qr_image=true and dry_run=false
TWILIO_PUBLIC_BASE_URL=
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_DRY_RUN=true
QR_IMAGE_DIR=data/qr
